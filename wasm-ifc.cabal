cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'wasm-ifc' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               wasm-ifc

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            MIT

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Abhiroop

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         asiamgenius@gmail.com

-- A copyright notice.
-- copyright:
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md


common warnings
    -- @-Werror=incomplete-patterns@ enforces the totality the typed interpreter's
    -- soundness argument relies on: a non-exhaustive 'step' would be a hole in the
    -- progress proof, so it must fail the build, not merely warn.
    ghc-options: -Wall -fno-cse -Werror=incomplete-patterns

-- The decoder, the typed interpreter, and the elaborator live in a library so they can be
-- reused by the executable and exercised directly by the test-suite.
library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:
        Syntax.Types
      , Syntax.Indices
      , Syntax.Immediates
      , Syntax.Instructions
      , Syntax.Expressions
      , Syntax.Globals
      , Syntax.Memories
      , Syntax.Functions
      , Syntax.Module
      , Validation.Shape
      , Validation.Reflect
      , Validation.Elaborate
      , Runtime.Values
      , Runtime.MemInst
      , Runtime.Trap
      , Runtime.Bytes
      , Runtime.Numeric
      , Runtime.Convert
      , Runtime.Stack
      , Runtime.Interpreter
      , Runtime.Examples
      , Codec.Wasm
    build-depends:
        base          ^>=4.21.0.0
      , containers    ^>=0.7
      , vector        ^>=0.13
      , singletons-th ==3.5
      , bytestring    ^>=0.12
      , binary        ^>=0.8
      , transformers  ^>=0.6
      , text          ^>=2.1

executable wasm-ifc
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    build-depends:
        base
      , wasm-ifc
      , bytestring
      , text

test-suite wasm-ifc-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    default-language: Haskell2010
    build-depends:
        base
      , wasm-ifc
