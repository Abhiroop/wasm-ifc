cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'wasm-ifc' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               wasm-ifc

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            MIT

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Abhiroop

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         asiamgenius@gmail.com

-- A copyright notice.
-- copyright:
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md


common warnings
    -- @-Werror=incomplete-patterns@ enforces the totality the typed interpreter's
    -- soundness argument relies on: a non-exhaustive 'step' would be a hole in the
    -- progress proof, so it must fail the build, not merely warn.
    --
    -- We follow STYLE.md's baseline. (Omitted deliberately: @-Wincomplete-uni-patterns@,
    -- which false-positives on this codebase's GADT-total single-clause binds such as
    -- @stepBin … (b :# a :# r)@; and @-Werror@ generally, which is left to CI.)
    ghc-options: -Wall -Wcompat
                 -Wincomplete-record-updates
                 -Wpartial-fields
                 -Wredundant-constraints
                 -Werror=incomplete-patterns
    default-language: GHC2024
    default-extensions:
        OverloadedStrings
        OverloadedRecordDot
        NoFieldSelectors
        DuplicateRecordFields

-- The decoder, the typed interpreter, and the elaborator live in a library so they can be
-- reused by the executable and exercised directly by the test-suite.
library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:
        Syntax.Types
      , Syntax.Indices
      , Syntax.Immediates
      , Syntax.Instructions
      , Syntax.Globals
      , Syntax.Functions
      , Syntax.Module
      , Validation.Shape
      , Validation.Reflect
      , Validation.Elaborate
      , Runtime.MemInst
      , Runtime.TableInst
      , Runtime.Trap
      , Runtime.Bytes
      , Runtime.Numeric
      , Runtime.Convert
      , Runtime.Stack
      , Runtime.Interpreter
      , Runtime.Module
      , Runtime.Host
      , Runtime.Wasi
      , Codec.Wasm
    build-depends:
        base          ^>=4.21.0.0
      , containers    ^>=0.7
      , vector        ^>=0.13
      , singletons-th ==3.5
      , singletons-base ^>=3.5
      , bytestring    ^>=0.12
      , binary        ^>=0.8
      , transformers  ^>=0.6
      , text          ^>=2.1
      , directory     ^>=1.3
      , filepath      ^>=1.5
      , time          ^>=1.14
      , unix          ^>=2.8

executable wasm-ifc
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base
      , wasm-ifc
      , bytestring
      , filepath
      , text

test-suite wasm-ifc-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    Examples
    hs-source-dirs:   test
    build-depends:
        base
      , wasm-ifc
      , bytestring
      , text
      , hspec          ^>=2.11
      , hedgehog       ^>=1.5
      , hspec-hedgehog ^>=0.3

-- The official spec testsuite, driven through wabt's wast2json (skips itself when the tool
-- or the submodule is missing).
test-suite wasm-ifc-spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          SpecSuite.hs
    hs-source-dirs:   test
    build-depends:
        base
      , wasm-ifc
      , aeson          ^>=2.2
      , bytestring
      , containers
      , directory
      , filepath
      , process
      , text
      , hspec          ^>=2.11

-- The official wasi-testsuite, run through the CLI (skips itself when the submodule is missing).
test-suite wasm-ifc-wasi
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          WasiSuite.hs
    hs-source-dirs:   test
    build-tool-depends: wasm-ifc:wasm-ifc
    build-depends:
        base
      , aeson          ^>=2.2
      , bytestring
      , containers
      , directory
      , filepath
      , process
      , text
      , hspec          ^>=2.11
